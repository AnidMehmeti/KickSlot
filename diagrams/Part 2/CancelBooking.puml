@startuml
autonumber
hide footbox
title Cancel a booking
actor Player
boundary "PlayerView\n[A3]" as View
control "BookingController\n[planned O2]" as Controller
control "BookingService\n[A2]" as Service
database "BookingRepository\n[A2]" as Repo
entity "Booking\n[A1]" as Booking
participant "Current State\n[A1]" as State
participant "NotificationSender\n[sample now · L3 planned]" as Sender
Player -> View : cancel selected booking
View -> Controller : onCancel(bookingId)
Controller -> Service : cancelBooking(currentPlayer, bookingId)
Service -> Service : require player role
Service -> Repo : all()
Repo --> Service : restored bookings
Service -> Service : find the booking by ID
Service -> Booking : belongsTo(currentPlayer)
alt different player
  Service --> Controller : throw ownership error
  Controller --> View : display reason
else authorized
  Service -> Booking : cancel(now)
  Booking -> State : cancel(now, start)
  alt illegal state or cancellation cutoff reached
    State --> Booking : throw transition error
    Booking --> Service : propagate error
    Service --> Controller : propagate error
    Controller --> View : display reason
  else allowed
    State --> Booking : new CancelledState
    Service -> Repo : save(booking)
    Service -> Sender : send(booking.playerId, message)
    Service --> Controller : updated booking
    Controller -> View : refresh list and show result
  end
end
legend bottom
A1–A3 = implemented. The preview supplies the controller callbacks.
endlegend
@enduml
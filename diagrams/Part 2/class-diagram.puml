@startuml
title KickSlot A0 - refined class overview (all components planned)
hide empty members
skinparam classAttributeIconSize 0

class DemoAccount {
  id
  name
  role
}
note right of DemoAccount
  Part 1's Player and Administrator become
  prepared accounts with role "player" or "admin".
end note

class BookingService {
  createBooking(player, pitchId, start, end)
  getUpcomingBookings(player)
  getManagedBookings(admin)
  cancelBooking(player, bookingId)
  confirmBooking(admin, bookingId)
  rejectBooking(admin, bookingId)
}
class Booking {
  playerId
  pitchId
  start
  end
  createdAt
  totalCents
  confirm()
  reject()
  cancel(now)
}
class BookingRepository {
  all()
  save(booking)
}
PlayerView ..> BookingController : callbacks
BookingController ..> DemoAccount : current actor
BookingController --> BookingService : delegates
BookingService --> BookingRepository
BookingService ..> Booking : checks owner and requests transition
Booking "1" --> "1" BookingState : current state
BookingState <|-- PendingState
BookingState <|-- ConfirmedState
BookingState <|-- RejectedState
BookingState <|-- CancelledState

interface NotificationSender {
  send(userId, message)
}
class InAppNotifier {
  send(userId, message)
  forUser(userId)
}
BookingService --> NotificationSender
NotificationSender <|.. InAppNotifier

interface FacilityComponent {
  deactivate()
  reactivate()
}
FacilityComponent <|.. Venue
FacilityComponent <|.. Pitch
class Venue {
  deactivate()
  reactivate()
}
class Pitch {
  deactivate()
  reactivate()
}
class FacilityService {
  createVenue(admin, details)
  reactivatePitch(admin, pitchId)
  reactivateVenue(admin, venueId)
  deletePitch(admin, pitchId)
  deactivate(admin, type, id)
}
class VenueRepository {
  all()
  find(id)
  save(venue)
}
class PitchRepository {
  all()
  find(id)
  save(pitch)
  remove(id)
}
VenueView ..> FacilityService : callbacks from main.js
FacilityService --> VenueRepository
FacilityService --> PitchRepository
FacilityService --> BookingRepository : checks history before deletion
Venue "1" *-- "0..*" Pitch : deactivates children
PitchBuilder ..> Pitch : builds
Pitch *-- OpeningHoursEntry
Pitch *-- PricingTier
BookingService ..> Pitch : checks hours and calculates price
BookingService ..> Venue : checks activity and manager
Booking "0..*" --> "1" Pitch : reserves
DemoAccount "1" -- "0..*" Booking : playerId
DemoAccount "1" -- "0..*" Venue : adminId
@enduml

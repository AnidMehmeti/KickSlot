@startuml
autonumber
skinparam SequenceMessageAlign center
show footbox

actor "admin: Administrator" as Admin
participant "service: BookingService" as Service
participant "booking: Booking" as Booking
participant "repo: BookingRepository" as Repo

Admin -> Service : rejectBooking(admin, booking)
activate Service

Service -> Admin : managesVenue(booking.pitch.venue)
activate Admin
Admin --> Service : true
deactivate Admin

Service -> Booking : reject()
activate Booking
Booking --> Service : void
deactivate Booking

Service -> Repo : save(booking)
activate Repo
Repo --> Service : void
deactivate Repo

Service --> Admin : void
deactivate Service
@enduml
